# ==========================================
# AI-Powered Digital Document Locker Config
# ==========================================

# Active Spring Profile (dev = H2 in-memory, aiven = Aiven Cloud MySQL)
SPRING_PROFILES_ACTIVE=dev

# Aiven Cloud MySQL Settings (Required for Phase 2)
# e.g.: jdbc:mysql://mysql-xxxxxx.aivencloud.com:12345/defaultdb?sslMode=REQUIRED
AIVEN_MYSQL_URL=
AIVEN_MYSQL_USER=avnadmin
AIVEN_MYSQL_PASSWORD=

# JWT Secret (Min 256-bit / 32+ characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Google Gemini AI API Key (Required for Phase 7)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Storage location for uploaded files
DOCUMENT_STORAGE_DIR=./storage/documents
